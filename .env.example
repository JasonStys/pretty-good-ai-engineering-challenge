# OpenAI credentials and models. Keep real values in .env; never commit them.
OPENAI_API_KEY=sk-your-key
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_QA_MODEL=gpt-5.6-luna
OPENAI_VOICE=ash

# Twilio credentials and the one assessment caller number in E.164 format.
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=+15555550123

# HTTPS tunnel or deployment URL pointing to this service.
PUBLIC_BASE_URL=https://replace-me.example

# The destination is intentionally immutable in code. This value must match it.
TARGET_PHONE_NUMBER=+18054398008

# Runtime controls.
ARTIFACT_DIR=artifacts/calls
SCENARIO_FILE=scenarios/default.yaml
MAX_CALL_SECONDS=180
RECORDING_WAIT_SECONDS=120
VALIDATE_TWILIO_SIGNATURE=true
LOG_LEVEL=INFO
